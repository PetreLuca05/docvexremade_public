# Copy to .env.local (not committed) for `npm run dev`. On GitHub the deploy
# workflow reads the same values from the repository's Actions variables
# (Settings → Secrets and variables → Actions → Variables). All of them are
# public by design: they end up in the site's JavaScript.

# The DocVex Supabase project (the same one the app signs in to):
# Project Settings → API → Project URL and the anon / publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Payment Links, one per paid plan (Stripe → Payment Links).
VITE_STRIPE_LINK_PRO=
VITE_STRIPE_LINK_CABINET=

# The customer portal's login page (Stripe → Settings → Billing → Customer
# portal), behind the header's Billing button.
VITE_STRIPE_PORTAL=

# Plausible (cookieless statistics): the site's domain as registered in
# Plausible (default docvex.ro) and the instance (default https://plausible.io;
# set it for a self-hosted one). Not loaded by `npm run dev` unless
# VITE_ANALYTICS_IN_DEV=true.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_HOST=
VITE_ANALYTICS_IN_DEV=

# Web Push for the admin dashboard (dev.html installed as an app): the VAPID
# public key (base64url). Its private half is the VAPID_PRIVATE_KEY secret of
# the Edge Functions; see docs/analytics.md.
VITE_VAPID_PUBLIC_KEY=

# Optional: a Facebook app id, written as fb:app_id into every page (link
# previews work without it). See SHARING.md.
VITE_FACEBOOK_APP_ID=
