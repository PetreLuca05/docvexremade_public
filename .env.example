# Copy to .env.local (not committed) for `npm run dev`. On GitHub the deploy
# workflow reads the same values from the repository's Actions variables
# (Settings → Secrets and variables → Actions → Variables). All of them are
# public by design: they end up in the site's JavaScript.

# The DocVex Supabase project (the same one the app signs in to):
# Project Settings → API → Project URL and the anon / publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Payment Links, one per paid plan (Stripe → Payment Links).
VITE_STRIPE_LINK_PRO=
VITE_STRIPE_LINK_CABINET=

# The customer portal's login page (Stripe → Settings → Billing → Customer
# portal), behind the header's Billing button.
VITE_STRIPE_PORTAL=
